#!/bin/bash

set -e

# Configuration
IMAGE_NAME="wac-dev"
IMAGE_TAG="latest"
FULL_IMAGE="${IMAGE_NAME}:${IMAGE_TAG}"
CONTAINER_USER="agent"
CONTAINER_UID="$(id -u)"
CONTAINER_GID="$(id -g)"
CONTAINER_HOME="/home/${CONTAINER_USER}"
CONTAINER_HOME_VOLUME_PREFIX="wac-home"
HOST_WAC_CONFIG_DIR="$HOME/.config/wac"
HOST_WAC_AUTH_DIR="$HOME/.local/share/opencode"
HOST_WAC_AUTH_FILE="$HOST_WAC_AUTH_DIR/auth.json"
HOST_HOME_REAL="$(cd "$HOME" && pwd -P)"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_debug() {
  if [ "$DEBUG" = true ]; then
    printf '[wac debug] %s\n' "$*" >&2
  fi
}

debug_print_command() {
  if [ "$DEBUG" != true ]; then
    return
  fi

  local arg
  printf '[wac debug] %s' "$1" >&2
  shift
  for arg in "$@"; do
    printf ' %q' "$arg" >&2
  done
  printf '\n' >&2
}

# Help message
show_help() {
  cat <<EOF
wac - Containerized Development Environment

Usage: wac [OPTIONS] [COMMAND...]

Options:
    --rebuild, -r       Force rebuild of the container image
    --no-cache          Rebuild without build cache
    --no-tty, -n        Run command without TTY and exit
    --debug             Print startup diagnostics
    --unsafe-mount      Allow mounting sensitive host directories
    --mount-ipfs        Mount host /ipfs and /ipns into the container read-only
    --memory-limit N    Limit container memory (example: 768m, 1g)
    --allow-root        Allow running WAC from a root-owned workspace
    --help, -h          Show this help message

Environment:
    WAC_CONTAINERFILE   Optional path to a custom Containerfile

Examples:
    wac bash                    Open shell in container
    wac opencode                Run opencode, then stay in shell
    wac tree                    Inspect the current directory
    wac -n opencode run hi      Run command and exit
    wac --unsafe-mount bash     Allow running from blocked directories

Security features:
    - Ephemeral container (--rm, cleaned up after exit)
    - Dropped capabilities (--cap-drop=all)
    - Host-backed XDG profile for persistent app state
    - Refuses to mount sensitive host directories unless explicitly allowed

Mounts:
    - Persistent per-project home volume -> ~
    - Current directory -> mirrored into container (read-write)
    - ~/.config/wac -> ~/.config (shared, read-write)
    - ~/.local/share/opencode/auth.json -> ~/.local/share/opencode/auth.json (shared auth)
    - ~/.local/share, ~/.local/state, ~/.cache live in the per-project home volume
EOF
}

# Parse options
REBUILD=false
NO_CACHE=false
RUN_NO_TTY=false
DEBUG=false
ALLOW_UNSAFE_MOUNT=false
ALLOW_ROOT=false
MOUNT_IPFS=false
MEMORY_LIMIT="${WAC_MEMORY_LIMIT:-}"
while [[ $# -gt 0 ]]; do
  case $1 in
  --rebuild | -r)
    REBUILD=true
    shift
    ;;
  --no-cache)
    REBUILD=true
    NO_CACHE=true
    shift
    ;;
  --no-tty | -n)
    RUN_NO_TTY=true
    shift
    ;;
  --debug)
    DEBUG=true
    shift
    ;;
  --unsafe-mount)
    ALLOW_UNSAFE_MOUNT=true
    shift
    ;;
  --mount-ipfs)
    MOUNT_IPFS=true
    shift
    ;;
  --memory-limit)
    MEMORY_LIMIT="$2"
    shift 2
    ;;
  --allow-root)
    ALLOW_ROOT=true
    shift
    ;;
  --help | -h)
    show_help
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

# Check if image exists
image_exists() {
  podman image exists "${FULL_IMAGE}" 2>/dev/null
}

print_embedded_containerfile() {
  cat <<'EOF'
FROM ubuntu:24.04

# Install prerequisites
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    tree \
    ripgrep \
    git \
    ca-certificates \
    gnupg \
    gh \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js 20
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install OpenCode and pnpm
RUN npm install -g opencode-ai@latest pnpm && \
    arch="$(dpkg --print-architecture)" && \
    if [ "$arch" = "arm64" ]; then \
        opencode_version="$(node -p "require('/usr/lib/node_modules/opencode-ai/package.json').version")" && \
        cd /usr/lib/node_modules/opencode-ai && \
        npm install --no-save "opencode-linux-arm64@${opencode_version}" && \
        rm -f /usr/lib/node_modules/opencode-ai/bin/.opencode; \
    fi

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

# Set working directory
WORKDIR /work

# Default command
CMD ["/bin/bash"]
EOF
}

generate_container_id() {
  local raw

  if command -v uuidgen >/dev/null 2>&1; then
    raw=$(uuidgen)
  elif [ -r /proc/sys/kernel/random/uuid ]; then
    raw=$(tr -d '\n' </proc/sys/kernel/random/uuid)
  else
    raw=$(openssl rand -hex 16)
  fi

  printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -d '-' | cut -c1-12
}

hash_project_scope() {
  local input="$1"
  local output

  if command -v shasum >/dev/null 2>&1; then
    output=$(printf '%s' "$input" | shasum -a 256)
    printf '%s' "${output%% *}"
    return
  fi

  if command -v sha256sum >/dev/null 2>&1; then
    output=$(printf '%s' "$input" | sha256sum)
    printf '%s' "${output%% *}"
    return
  fi

  if command -v openssl >/dev/null 2>&1; then
    output=$(printf '%s' "$input" | openssl dgst -sha256)
    printf '%s' "${output##* }"
    return
  fi

  echo -e "${RED}Error: could not compute a project key (need shasum, sha256sum, or openssl).${NC}" >&2
  exit 1
}

sanitize_project_label() {
  local label="$1"

  label=$(printf '%s' "$label" | tr -cs '[:alnum:]. _-' '-')
  label=${label// /-}
  label=${label#-}
  label=${label%-}

  if [ -z "$label" ]; then
    label="project"
  fi

  printf '%s' "$label"
}

is_sensitive_mount_dir() {
  local path="$1"

  case "$path" in
  "$HOME" | "$HOST_HOME_REAL" | / | /etc | /var | /usr | /boot | /opt | /dev | /sys | /proc | /System | /Library | /Applications | /Users)
    return 0
    ;;
  esac

  return 1
}

reject_sensitive_mount_dir() {
  local path="$1"

  if ! is_sensitive_mount_dir "$path"; then
    return
  fi

  if [ "$ALLOW_UNSAFE_MOUNT" = true ]; then
    echo -e "${YELLOW}Warning: mounting sensitive host directory ${path} because --unsafe-mount was provided.${NC}" >&2
    return
  fi

  echo -e "${RED}Error: refusing to mount sensitive host directory ${path}.${NC}" >&2
  echo -e "${YELLOW}Use --unsafe-mount to override this protection if you really intend to expose it to the container.${NC}" >&2
  exit 1
}

# Build image
build_image() {
  local build_context
  local build_args=()

  echo -e "${YELLOW}Building container image: ${FULL_IMAGE}${NC}"

  if [ "$NO_CACHE" = true ]; then
    build_args+=(--pull=always --no-cache)
  fi

  if [ -n "${WAC_CONTAINERFILE:-}" ]; then
    if [ ! -f "${WAC_CONTAINERFILE}" ]; then
      echo -e "${RED}Error: WAC_CONTAINERFILE does not exist: ${WAC_CONTAINERFILE}${NC}" >&2
      exit 1
    fi

    log_debug "building image from custom Containerfile at ${WAC_CONTAINERFILE}"
    podman build "${build_args[@]}" -t "${FULL_IMAGE}" -f "${WAC_CONTAINERFILE}" "$(dirname "${WAC_CONTAINERFILE}")"
  else
    build_context=$(mktemp -d)
    trap 'rm -rf "$build_context"' RETURN

    log_debug "building image from embedded Containerfile"
    print_embedded_containerfile | podman build "${build_args[@]}" -t "${FULL_IMAGE}" -f - "${build_context}"
  fi

  echo -e "${GREEN}Image built successfully!${NC}"
}

# Rebuild if requested
if [ "$REBUILD" = true ]; then
  build_image
fi

if [ "$EUID" -eq 0 ] && [ "$ALLOW_ROOT" != true ] && [ "${WAC_ALLOW_ROOT:-}" != 1 ]; then
  echo -e "${RED}Error: refusing to run wac as root.${NC}" >&2
  echo -e "${YELLOW}Run it as your normal user, or pass --allow-root / WAC_ALLOW_ROOT=1 for this root-owned workspace.${NC}" >&2
  exit 1
fi

# Build image if it doesn't exist
if ! image_exists; then
  echo -e "${YELLOW}Image ${FULL_IMAGE} not found. Building...${NC}"
  build_image
fi

# Set container identity and working directory
PROJECT_SCOPE_DIR="$(pwd -P)"
reject_sensitive_mount_dir "$PROJECT_SCOPE_DIR"

MOUNT_HOME_AS_WORKDIR=false
if [ "$PROJECT_SCOPE_DIR" = "$HOST_HOME_REAL" ]; then
  CONTAINER_WORK_DIR="${CONTAINER_HOME}"
  MOUNT_HOME_AS_WORKDIR=true
elif [[ "$PROJECT_SCOPE_DIR" == "$HOST_HOME_REAL/"* ]]; then
  CONTAINER_WORK_DIR="${CONTAINER_HOME}/${PROJECT_SCOPE_DIR#"$HOST_HOME_REAL"/}"
else
  CONTAINER_WORK_DIR="$PROJECT_SCOPE_DIR"
fi

CONTAINER_ID="$(generate_container_id)"
CONTAINER_HOSTNAME="wac-${CONTAINER_ID}"
CONTAINER_INSTANCE_NAME="${CONTAINER_HOSTNAME}"
PROJECT_LABEL="$(sanitize_project_label "$(basename "$PROJECT_SCOPE_DIR")")"
PROJECT_HASH="$(hash_project_scope "$PROJECT_SCOPE_DIR")"
PROJECT_KEY="${PROJECT_LABEL}-${PROJECT_HASH:0:12}"
CONTAINER_HOME_VOLUME="${CONTAINER_HOME_VOLUME_PREFIX}-${PROJECT_KEY}"

log_debug "pwd=$PWD"
log_debug "project_scope_dir=$PROJECT_SCOPE_DIR"
log_debug "project_key=$PROJECT_KEY"
log_debug "container_home_volume=$CONTAINER_HOME_VOLUME"
log_debug "host_config_dir=$HOST_WAC_CONFIG_DIR"
log_debug "host_auth_file=$HOST_WAC_AUTH_FILE"

ensure_dir_exists() {
  local path="$1"
  mkdir -p "$path"
}

seed_dir_if_missing() {
  local source="$1"
  local target="$2"
  local label="$3"

  if [ ! -e "$source" ]; then
    log_debug "skip bootstrap for ${label}: source missing at $source"
    return
  fi

  if [ -e "$target" ]; then
    log_debug "skip bootstrap for ${label}: target already exists at $target"
    return
  fi

  echo -e "${YELLOW}Bootstrapping ${label} into WAC profile...${NC}"
  log_debug "bootstrapping ${label}: $source -> $target"
  mkdir -p "$target"
  cp -R "$source/." "$target/"
  log_debug "finished bootstrapping ${label}"
}

initialize_volume_home() {
  log_debug "initializing XDG directories in volume ${CONTAINER_HOME_VOLUME}"

  podman run --rm \
    --user "${CONTAINER_UID}:${CONTAINER_GID}" \
    -e HOME="${CONTAINER_HOME}" \
    -v "${CONTAINER_HOME_VOLUME}:${CONTAINER_HOME}:U" \
    "${FULL_IMAGE}" \
    /bin/bash -lc 'mkdir -p "$HOME/.local/state" "$HOME/.local/share" "$HOME/.local/share/opencode/log" "$HOME/.cache"'
}

ensure_json_object_file() {
  local path="$1"

  if [ -e "$path" ]; then
    log_debug "json file already exists at $path"
    return
  fi

  mkdir -p "$(dirname "$path")"
  printf '{}\n' >"$path"
  log_debug "created json file at $path"
}

is_shell_command() {
  case "$1" in
  bash | /bin/bash | sh | /bin/sh | zsh | /bin/zsh | dash | /bin/dash | fish | /usr/bin/fish)
    return 0
    ;;
  *)
    return 1
    ;;
  esac
}

# Ensure host-backed XDG directories exist
ensure_dir_exists "$HOST_WAC_CONFIG_DIR"
ensure_dir_exists "$HOST_WAC_AUTH_DIR"
log_debug "ensured host directories"

# Maintain one shared auth file while keeping project-local state in the volume
ensure_json_object_file "$HOST_WAC_AUTH_FILE"
chmod 600 "$HOST_WAC_AUTH_FILE" 2>/dev/null || true
log_debug "ensured shared auth file exists"

# Seed commonly used config once into the WAC profile
seed_dir_if_missing "$HOME/.config/opencode" "$HOST_WAC_CONFIG_DIR/opencode" "OpenCode config"
log_debug "seeded shared config directories if missing"

# Ensure the named home volume already contains writable XDG directories
initialize_volume_home

# Prepare mount arguments
MOUNTS=(
  # Per-project home volume plus shared config and shared auth
  -v "${CONTAINER_HOME_VOLUME}:${CONTAINER_HOME}:U"
  -v "$HOST_WAC_CONFIG_DIR:${CONTAINER_HOME}/.config"
  -v "$HOST_WAC_AUTH_FILE:${CONTAINER_HOME}/.local/share/opencode/auth.json"
)

if [ "$MOUNT_HOME_AS_WORKDIR" = true ]; then
  log_debug "pwd equals home; host home bind overrides project home volume"
  MOUNTS=(
    -v "$PROJECT_SCOPE_DIR:${CONTAINER_WORK_DIR}"
    -v "$HOST_WAC_CONFIG_DIR:${CONTAINER_HOME}/.config"
    -v "$HOST_WAC_AUTH_FILE:${CONTAINER_HOME}/.local/share/opencode/auth.json"
  )
else
  MOUNTS=(
    -v "$PROJECT_SCOPE_DIR:${CONTAINER_WORK_DIR}"
    "${MOUNTS[@]}"
  )
fi

if [ "$MOUNT_IPFS" = true ]; then
  if ! mountpoint -q /ipfs || ! mountpoint -q /ipns; then
    echo -e "${RED}Error: --mount-ipfs requires mounted /ipfs and /ipns FUSE paths.${NC}" >&2
    echo -e "${YELLOW}Run ipfs mount before using --mount-ipfs.${NC}" >&2
    exit 1
  fi
  MOUNTS+=(-v /ipfs:/ipfs:ro -v /ipns:/ipns:ro)
fi

# Default to bash if no command specified
if [ $# -eq 0 ]; then
  if [ "$RUN_NO_TTY" = true ]; then
    echo -e "${RED}Error: --no-tty requires a command.${NC}" >&2
    exit 1
  fi

  set -- /bin/bash
fi

RUN_ARGS=("$@")
if [ "$RUN_NO_TTY" = false ] && ! is_shell_command "$1"; then
  RUN_ARGS=(
    /bin/bash
    -lc
    '"$@"; status=$?; if [ $status -ne 0 ]; then printf "\nCommand exited with status %d\n" "$status"; fi; exec /bin/bash'
    _
    "$@"
  )
fi

TTY_ARGS=()
if [ "$RUN_NO_TTY" = false ]; then
  TTY_ARGS=(-it)
fi

PODMAN_ARGS=(
  --rm
  "${TTY_ARGS[@]}"
  --name "${CONTAINER_INSTANCE_NAME}"
  --hostname "${CONTAINER_HOSTNAME}"
  --cap-drop=all
  --passwd-entry "${CONTAINER_USER}:x:${CONTAINER_UID}:${CONTAINER_GID}::${CONTAINER_HOME}:/bin/bash"
  --user "${CONTAINER_UID}:${CONTAINER_GID}"
  -e HOME="${CONTAINER_HOME}"
  -e USER="${CONTAINER_USER}"
  -e LOGNAME="${CONTAINER_USER}"
  -e XDG_CONFIG_HOME="${CONTAINER_HOME}/.config"
  -e XDG_DATA_HOME="${CONTAINER_HOME}/.local/share"
  -e XDG_STATE_HOME="${CONTAINER_HOME}/.local/state"
  -e XDG_CACHE_HOME="${CONTAINER_HOME}/.cache"
  -w "${CONTAINER_WORK_DIR}"
  "${MOUNTS[@]}"
  "${FULL_IMAGE}"
  "${RUN_ARGS[@]}"
)

if [ -n "$MEMORY_LIMIT" ]; then
  PODMAN_ARGS=(--memory "$MEMORY_LIMIT" "${PODMAN_ARGS[@]}")
fi

debug_print_command "podman run" "${PODMAN_ARGS[@]}"

exec podman run "${PODMAN_ARGS[@]}"
